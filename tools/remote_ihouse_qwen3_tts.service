[Unit]
Description=iHouse Qwen3 TTS local service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=12

[Service]
Type=simple
WorkingDirectory=/home/saita/qwen3-tts-service
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=0
Environment=QWEN3_TTS_API_TOKEN=local-qwen3-tts-5090
Environment=QWEN3_TTS_MAX_REQUESTS_BEFORE_RECYCLE=36
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:256
ExecStartPre=/usr/bin/nvidia-smi
ExecStart=/home/saita/qwen3-tts-service/start.sh
Restart=on-failure
RestartSec=8

[Install]
WantedBy=default.target
