# 火山引擎 (OmniHuman数字人 + TTS)
VOLC_ACCESS_KEY=your_volc_access_key
VOLC_SECRET_KEY=your_volc_secret_key

# Claude API (旧备用文案生成；启用 FORCE_SCRIPT_MODEL_PROVIDER 后不会用于主文案)
ANTHROPIC_API_KEY=your_anthropic_api_key

# 统一文案模型：普通数字人、AI 修改、批量数字人、OpenNews 新闻稿和多语言稿统一走 GPT-5.4 Chat Completions。
FORCE_SCRIPT_MODEL_PROVIDER=api_relay
FORCE_SCRIPT_MODEL_LABEL=GPT-5.4 统一文案模型
OPENAI_RELAY_API_KEY=your_openai_relay_api_key
OPENAI_RELAY_BASE_URL=https://api.office.ihousejapan.cn
OPENAI_RELAY_MODEL=gpt-5.4
OPENAI_RELAY_REASONING_EFFORT=low
OPENAI_RELAY_MERGE_INSTRUCTIONS_INTO_INPUT=0
OPENAI_RELAY_USE_CHAT_COMPLETIONS=1
OPENNEWS_MODEL_PROVIDER=relay
OPENNEWS_RELAY_MODEL=gpt-5.4
OPENNEWS_RELAY_REASONING_EFFORT=low
OPENNEWS_RELAY_USE_CHAT_COMPLETIONS=1

# 5090 本地文案模型（仅在不启用 FORCE_SCRIPT_MODEL_PROVIDER 时用于管理员本地 Qwen 文案）。
# 本地 5090 OpenAI-compatible 服务默认不需要 LOCAL_QWEN_API_KEY。
OPENNEWS_LOCAL_LLM_BASE_URL=http://192.168.0.34:11434/v1
OPENNEWS_LOCAL_LLM_MODEL=hf.co/bartowski/Qwen_Qwen3-30B-A3B-Instruct-2507-GGUF:Q4_K_M
OPENNEWS_LOCAL_LLM_WAIT_FOREVER=1
LOCAL_QWEN_BASE_URL=http://192.168.0.34:11434/v1
LOCAL_QWEN_MODEL=hf.co/bartowski/Qwen_Qwen3-30B-A3B-Instruct-2507-GGUF:Q4_K_M

# MiniMax (TTS配音)
MINIMAX_API_KEY=your_minimax_api_key

# OpenNews 新闻配音固定走 5090 Qwen3-TTS，不再回退 MiniMax。
OPENNEWS_QWEN_TTS_ENABLED=1
OPENNEWS_QWEN_TTS_BASE_URL=http://192.168.0.34:8895
OPENNEWS_QWEN_TTS_TOKEN=local-qwen3-tts-5090
OPENNEWS_QWEN_TTS_TIMEOUT=180
OPENNEWS_QWEN_TTS_RETRY_INTERVAL_SECONDS=30
OPENNEWS_QWEN_TTS_GPU_UNAVAILABLE_RETRY_INTERVAL_SECONDS=120

# Pexels (素材搜索)
PEXELS_API_KEY=你的PexelsAPIKey
# OpenNews 免费素材图复用限制：同一张图 24 小时内最多使用 3 次，单个批次内不重复。
OPENNEWS_PEXELS_IMAGE_DAILY_LIMIT=3
# OpenNews 免费素材匹配：默认严格要求图片自身描述命中文案实体/领域/场景。
OPENNEWS_PEXELS_STRICT_MATCH_ENABLED=1
OPENNEWS_PEXELS_MIN_RELEVANCE_SCORE=28
# OpenNews 自动发布：重复图默认只警告不阻断；设为 1 可恢复硬阻断。
OPENNEWS_AUTO_PUBLISH_DUPLICATE_IMAGE_BLOCKING=0
OPENNEWS_COLLECTION_DUPLICATE_IMAGE_BLOCKING=0

# 火山方舟 Seedream 5.0 Lite（管理员主播图生成）
ARK_API_KEY=你的ArkApiKey
ARK_IMAGE_MODEL=doubao-seedream-5-0-lite-260128

# X / Twitter 自动发布
X_CONSUMER_KEY=your_x_consumer_key
X_CONSUMER_SECRET=your_x_consumer_secret
X_BEARER_TOKEN=your_x_bearer_token
X_CLIENT_ID=your_x_oauth2_client_id
X_CLIENT_SECRET=your_x_oauth2_client_secret
X_REDIRECT_URI=https://aiagent.office.ihousejapan.cn/api/x/oauth/callback
# OAuth 回调后会自动保存 access/refresh token 到 output/x_auth/x_token.json，通常不用手填 X_ACCESS_TOKEN。
OPENNEWS_X_PUBLISH_MODE=browser
X_BROWSER_HEADLESS=1
X_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
X_BROWSER_UPLOAD_TIMEOUT_SECONDS=900
X_BROWSER_POST_TIMEOUT_SECONDS=120
X_BROWSER_LOGIN_DISPLAY=:99
X_BROWSER_LOGIN_NOVNC_PORT=6090
X_BROWSER_LOGIN_VNC_PORT=5901
X_BROWSER_LOGIN_PUBLIC_BASE_URL=https://aiagent.office.ihousejapan.cn:6090
OPENNEWS_X_AUTO_PUBLISH_ENABLED=0
OPENNEWS_X_AUTO_PUBLISH_DISABLED=0
OPENNEWS_X_PUBLISH_SINGLE_SHORTS_ENABLED=1
OPENNEWS_X_PUBLISH_COLLECTION_ENABLED=0

# Facebook 自动发布
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://aiagent.office.ihousejapan.cn/api/facebook/oauth/callback
# 如果不手填 PAGE_ID / PAGE_ACCESS_TOKEN，OAuth 回调后会自动保存到 output/facebook_auth/facebook_token.json
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
OPENNEWS_FACEBOOK_AUTO_PUBLISH_ENABLED=0
OPENNEWS_FACEBOOK_AUTO_PUBLISH_DISABLED=0
OPENNEWS_FACEBOOK_PUBLISH_SINGLE_SHORTS_ENABLED=1
OPENNEWS_FACEBOOK_PUBLISH_COLLECTION_ENABLED=0

# 话题采集接口(数字人选题自动化)
TOPIC_COLLECTOR_API_URL=https://topic.office.ihousejapan.cn/api/topic-collector/records/all
TOPIC_COLLECTOR_API_TOKEN=your_topic_api_token

# JClaw 媒体数据中心：只回采本系统发布回执对应的视频。
MEDIA_INSIGHTS_SYNC_ENABLED=1
MEDIA_INSIGHTS_SYNC_INTERVAL_SECONDS=1800
MEDIA_INSIGHTS_SYNC_BATCH_SIZE=120
# 默认写入 output/media_insights/media_insights.db；只有迁移持久化目录时才需要覆盖。
# MEDIA_INSIGHTS_DB_PATH=/app/output/media_insights/media_insights.db
